exports[`sendMessage queryOpts characterization > claude-code: agent session with a caller alias (proxy + MCP_KEY_ALIAS rewrite) 1`] = `
{
  "codexRouteCalls": 0,
  "logs": [
    "warn: MCP server "fake-missing" (plugin plugin-1) has an unlaunchable command "no-such-mcp-server" — it will fail to start and its mcp__fake-missing__* tools will be absent from the session",
    "info: Built 1 hook callback(s) from enabled plugins",
    "info: Injected callboard-tools MCP server",
    "info: Injected proxy tools (mode=local, alias=agent-caller)",
    "debug: Set MCP_KEY_ALIAS="agent-caller" for agent=keyed-agent",
    "info: Injected Callboard agent tools for agent="keyed-agent" (spec.name=callboard, 35 tools)",
    "info: MCP servers for session: [fake-stdio(stdio), fake-missing(stdio), fake-http(http), computer_use(stdio), callboard-tools(stdio), mcp-proxy(stdio), callboard(stdio)], allowedTools: [mcp__fake-stdio__*, mcp__fake-missing__*, mcp__fake-http__*, mcp__callboard-tools__*, mcp__mcp-proxy__*, mcp__callboard__*]",
    "debug: SDK query options — provider=claude-code, cwd=<work>, maxTurns=200, model=(default), resume=none",
  ],
  "request": {
    "options": {
      "abortController": "[AbortController]",
      "allowedTools": [
        "mcp__fake-stdio__*",
        "mcp__fake-missing__*",
        "mcp__fake-http__*",
        "mcp__callboard-tools__*",
        "mcp__mcp-proxy__*",
        "mcp__callboard__*",
      ],
      "canUseTool": "[Function]",
      "cwd": "<work>",
      "env": {
        "CB_QUERYOPTS_TEST_TOKEN": "resolved-token",
        "CLAUDECODE": undefined,
        "CODEX_HOME": "/nonexistent/queryopts-home/.codex",
        "HOME": "/nonexistent/queryopts-home",
        "INHERITED_PLAIN": "kept",
        "MCP_KEY_ALIAS": "agent-caller",
        "PATH": "<data>/bin",
        "TOKEN": "resolved-token",
      },
      "hooks": {
        "PreToolUse": [
          {
            "hooks": [
              "[Function]",
            ],
            "matcher": "Bash",
            "timeout": 5,
          },
        ],
      },
      "maxTurns": 200,
      "mcpServerOrder": [
        "fake-stdio",
        "fake-missing",
        "fake-http",
        "computer_use",
        "callboard-tools",
        "mcp-proxy",
        "callboard",
      ],
      "mcpServers": {
        "callboard": "[ToolServer callboard: 35 tools]",
        "callboard-tools": "[ToolServer callboard-tools: 48 tools]",
        "computer_use": "[ToolServer computer_use: 6 tools]",
        "fake-http": {
          "headers": {
            "x-test": "1",
          },
          "type": "http",
          "url": "http://localhost:1/mcp",
        },
        "fake-missing": {
          "args": [],
          "command": "no-such-mcp-server",
        },
        "fake-stdio": {
          "args": [
            "<data>/fake-plugin/server.js",
            "-y",
          ],
          "command": "fake-mcp-server",
          "env": {
            "MCP_KEY_ALIAS": "agent-caller",
            "TOKEN": "resolved-token",
          },
        },
        "mcp-proxy": "[ToolServer mcp-proxy: 13 tools]",
      },
      "pathToClaudeCodeExecutable": "/opt/fake/bin/claude",
      "plugins": [
        {
          "name": "fake-plugin",
          "path": "<data>/fake-plugin",
          "type": "local",
        },
      ],
      "settingSources": [
        "user",
        "project",
        "local",
      ],
      "stderr": "[Function]",
    },
    "prompt": "[AsyncIterable]",
  },
}
`;

