# ============================================================
# Drawlatch E2E Tests — Environment Variables
# ============================================================
# Copy to .env.e2e and fill in values for the connections you
# want to test. Tests for connections with missing env vars
# will be skipped automatically.
# ============================================================

# ------------------------------------------------------------
# GitHub (webhook simulation — no public URL needed)
# ------------------------------------------------------------
# PAT with repo access (used by test_connection verification)
GITHUB_TOKEN=
# Arbitrary shared secret for signing simulated webhook payloads
GITHUB_WEBHOOK_SECRET=e2e-test-secret

# ------------------------------------------------------------
# Discord Bot (real Gateway WebSocket connection)
# ------------------------------------------------------------
# Bot token with MESSAGE_CONTENT intent enabled
DISCORD_BOT_TOKEN=
# Channel ID to send a test message to (bot must have access)
DISCORD_E2E_CHANNEL_ID=
# Guild ID the test channel belongs to
DISCORD_E2E_GUILD_ID=

# ------------------------------------------------------------
# Trello (webhook simulation — no public URL needed)
# ------------------------------------------------------------
# API key and token (used by test_connection verification)
TRELLO_API_KEY=
TRELLO_TOKEN=
# Arbitrary shared secret for signing simulated webhook payloads
TRELLO_API_SECRET=e2e-test-secret

# ------------------------------------------------------------
# Google: the google connection (live token minting; server.e2e.test.ts)
# ------------------------------------------------------------
# The selection to test, as JSON service -> level (default below). The suite
# prints the matching consent scopes when it skips.
GOOGLE_E2E_SELECTION={"gmail":"read","calendar":"read","drive":"read","sheets":"edit","docs":"edit","slides":"edit"}
# Desktop-app OAuth client, plus ONE refresh token consented for exactly the
# selection's consent scopes, with access_type=offline and prompt=consent
# (recipe in CONNECTIONS.md, "Google" > "User OAuth setup"). For the default:
#   gmail.readonly calendar.readonly drive.readonly spreadsheets documents
#   presentations
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Optional: service-account key, base64 of the JSON key file (base64 -w0 key.json).
# Runs the selection's service-account levels (no gmail without a subject)
# against files shared with the service account.
GOOGLE_SERVICE_ACCOUNT_KEY=
# Optional: a Workspace user the service account may act as (domain-wide
# delegation authorized for the selection's scopes). Adds gmail.
GOOGLE_E2E_SUBJECT=
