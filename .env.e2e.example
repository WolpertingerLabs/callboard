# ============================================================
# Drawlatch E2E Tests — Environment Variables
# ============================================================
# Copy to .env.e2e and fill in values for the connections you
# want to test. Tests for connections with missing env vars
# will be skipped automatically.
# ============================================================

# ------------------------------------------------------------
# GitHub (webhook simulation — no public URL needed)
# ------------------------------------------------------------
# PAT with repo access (used by test_connection verification)
GITHUB_TOKEN=
# Arbitrary shared secret for signing simulated webhook payloads
GITHUB_WEBHOOK_SECRET=e2e-test-secret

# ------------------------------------------------------------
# Discord Bot (real Gateway WebSocket connection)
# ------------------------------------------------------------
# Bot token with MESSAGE_CONTENT intent enabled
DISCORD_BOT_TOKEN=
# Channel ID to send a test message to (bot must have access)
DISCORD_E2E_CHANNEL_ID=
# Guild ID the test channel belongs to
DISCORD_E2E_GUILD_ID=

# ------------------------------------------------------------
# Trello (webhook simulation — no public URL needed)
# ------------------------------------------------------------
# API key and token (used by test_connection verification)
TRELLO_API_KEY=
TRELLO_TOKEN=
# Arbitrary shared secret for signing simulated webhook payloads
TRELLO_API_SECRET=e2e-test-secret

# ------------------------------------------------------------
# Google, scoped templates (live token minting; server.e2e.test.ts)
# ------------------------------------------------------------
# Desktop-app OAuth client, plus a refresh token consented ONCE for the
# superset of the user templates' scopes, with access_type=offline and
# prompt=consent (recipe in CONNECTIONS.md, "Google (scoped)"):
#   gmail.metadata gmail.readonly calendar.freebusy calendar.readonly
#   drive.readonly drive.file spreadsheets.readonly spreadsheets
# This doubles as the live check of scope narrowing on refresh: if Google
# returns the full grant instead of the requested scope, the tests fail with
# "granted scopes broader than this connection allows".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Optional: service-account key, base64 of the JSON key file (base64 -w0 key.json).
# Enables the -sa template cases (Calendar, Drive, Sheets: files shared with the
# service account).
GOOGLE_SERVICE_ACCOUNT_KEY=
# Optional: a Workspace user the service account may impersonate (domain-wide
# delegation authorized for gmail.readonly). Enables google-gmail-readonly-sa.
GOOGLE_E2E_SUBJECT=
