{
  "name": "Google Calendar (read-only, service account)",
  "stability": "beta",
  "category": "productivity",
  "description": "Google Calendar, read-only (scope calendar.readonly): calendar list, calendars, events, event instances, free/busy, colors, and settings. Cannot create, change, or delete events. Auth: drawlatch signs a JWT with GOOGLE_SERVICE_ACCOUNT_KEY (base64 of the service-account JSON key file) and mints short-lived access tokens for exactly this scope; the agent never sees the key. Without a subject it reads calendars shared with the service account; with one (domain-wide delegation) it reads that user's. See CONNECTIONS.md \"Google (scoped)\".",
  "docsUrl": "https://developers.google.com/workspace/calendar/api/v3/reference",
  "secrets": {
    "GOOGLE_SERVICE_ACCOUNT_KEY": "${GOOGLE_SERVICE_ACCOUNT_KEY}"
  },
  "oauth2": {
    "tokenUrl": "https://oauth2.googleapis.com/token",
    "grant": "jwt_bearer",
    "secretRefs": {
      "serviceAccountKey": "GOOGLE_SERVICE_ACCOUNT_KEY"
    },
    "scopes": [
      "https://www.googleapis.com/auth/calendar.readonly"
    ]
  },
  "allowedEndpoints": [
    "https://www.googleapis.com/calendar/v3/users/me/calendarList",
    "https://www.googleapis.com/calendar/v3/users/me/calendarList?**",
    "https://www.googleapis.com/calendar/v3/users/me/calendarList/*",
    "https://www.googleapis.com/calendar/v3/users/me/calendarList/*?**",
    "!https://www.googleapis.com/calendar/v3/users/me/calendarList/watch",
    "!https://www.googleapis.com/calendar/v3/users/me/calendarList/watch?**",
    "https://www.googleapis.com/calendar/v3/users/me/settings",
    "https://www.googleapis.com/calendar/v3/users/me/settings?**",
    "https://www.googleapis.com/calendar/v3/users/me/settings/*",
    "https://www.googleapis.com/calendar/v3/users/me/settings/*?**",
    "!https://www.googleapis.com/calendar/v3/users/me/settings/watch",
    "!https://www.googleapis.com/calendar/v3/users/me/settings/watch?**",
    "https://www.googleapis.com/calendar/v3/calendars/*",
    "https://www.googleapis.com/calendar/v3/calendars/*?**",
    "https://www.googleapis.com/calendar/v3/calendars/*/events",
    "https://www.googleapis.com/calendar/v3/calendars/*/events?**",
    "https://www.googleapis.com/calendar/v3/calendars/*/events/*",
    "https://www.googleapis.com/calendar/v3/calendars/*/events/*?**",
    "https://www.googleapis.com/calendar/v3/calendars/*/events/*/instances",
    "https://www.googleapis.com/calendar/v3/calendars/*/events/*/instances?**",
    "!https://www.googleapis.com/calendar/v3/calendars/*/events/watch",
    "!https://www.googleapis.com/calendar/v3/calendars/*/events/watch?**",
    "https://www.googleapis.com/calendar/v3/freeBusy",
    "https://www.googleapis.com/calendar/v3/freeBusy?**",
    "https://www.googleapis.com/calendar/v3/colors",
    "https://www.googleapis.com/calendar/v3/colors?**"
  ],
  "testConnection": {
    "url": "https://www.googleapis.com/calendar/v3/users/me/calendarList?maxResults=1",
    "description": "Lists one entry of the user's calendar list"
  }
}
