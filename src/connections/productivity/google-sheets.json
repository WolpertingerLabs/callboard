{
  "name": "Google Sheets (read-write)",
  "stability": "beta",
  "category": "productivity",
  "description": "Google Sheets, read and edit (scope spreadsheets): spreadsheets.create, get, batchUpdate (formatting, sheets, charts, …), getByDataFilter; values get/update/append/clear and the batch and DataFilter variants; sheets.copyTo; developerMetadata get/search. Reaches every spreadsheet the Google account can open, not just chosen ones; no Drive endpoints, so it cannot share, move, or delete files. Auth: drawlatch mints short-lived access tokens from GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET and GOOGLE_OAUTH_REFRESH_TOKEN (user OAuth; the agent never sees them) and refuses any token broader than this scope. See CONNECTIONS.md \"Google (scoped)\".",
  "docsUrl": "https://developers.google.com/workspace/sheets/api/reference/rest",
  "secrets": {
    "GOOGLE_OAUTH_CLIENT_ID": "${GOOGLE_OAUTH_CLIENT_ID}",
    "GOOGLE_OAUTH_CLIENT_SECRET": "${GOOGLE_OAUTH_CLIENT_SECRET}",
    "GOOGLE_OAUTH_REFRESH_TOKEN": "${GOOGLE_OAUTH_REFRESH_TOKEN}"
  },
  "oauth2": {
    "tokenUrl": "https://oauth2.googleapis.com/token",
    "grant": "refresh_token",
    "clientAuth": "body",
    "secretRefs": {
      "clientId": "GOOGLE_OAUTH_CLIENT_ID",
      "clientSecret": "GOOGLE_OAUTH_CLIENT_SECRET",
      "refreshToken": "GOOGLE_OAUTH_REFRESH_TOKEN"
    },
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets"
    ]
  },
  "allowedEndpoints": [
    "https://sheets.googleapis.com/v4/spreadsheets",
    "https://sheets.googleapis.com/v4/spreadsheets?**",
    "https://sheets.googleapis.com/v4/spreadsheets/*",
    "https://sheets.googleapis.com/v4/spreadsheets/*?**",
    "https://sheets.googleapis.com/v4/spreadsheets/*/values/*",
    "https://sheets.googleapis.com/v4/spreadsheets/*/values/*?**",
    "https://sheets.googleapis.com/v4/spreadsheets/*/values:batchGet",
    "https://sheets.googleapis.com/v4/spreadsheets/*/values:batchGet?**",
    "https://sheets.googleapis.com/v4/spreadsheets/*/values:batchUpdate",
    "https://sheets.googleapis.com/v4/spreadsheets/*/values:batchUpdate?**",
    "https://sheets.googleapis.com/v4/spreadsheets/*/values:batchClear",
    "https://sheets.googleapis.com/v4/spreadsheets/*/values:batchClear?**",
    "https://sheets.googleapis.com/v4/spreadsheets/*/values:batchGetByDataFilter",
    "https://sheets.googleapis.com/v4/spreadsheets/*/values:batchGetByDataFilter?**",
    "https://sheets.googleapis.com/v4/spreadsheets/*/values:batchUpdateByDataFilter",
    "https://sheets.googleapis.com/v4/spreadsheets/*/values:batchUpdateByDataFilter?**",
    "https://sheets.googleapis.com/v4/spreadsheets/*/values:batchClearByDataFilter",
    "https://sheets.googleapis.com/v4/spreadsheets/*/values:batchClearByDataFilter?**",
    "https://sheets.googleapis.com/v4/spreadsheets/*/sheets/*:copyTo",
    "https://sheets.googleapis.com/v4/spreadsheets/*/sheets/*:copyTo?**",
    "https://sheets.googleapis.com/v4/spreadsheets/*/developerMetadata/*",
    "https://sheets.googleapis.com/v4/spreadsheets/*/developerMetadata/*?**",
    "https://sheets.googleapis.com/v4/spreadsheets/*/developerMetadata:search",
    "https://sheets.googleapis.com/v4/spreadsheets/*/developerMetadata:search?**"
  ],
  "testConnection": {
    "url": "https://sheets.googleapis.com/v4/spreadsheets/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms?fields=spreadsheetId",
    "description": "Reads the ID of Google's public sample spreadsheet (needs the Sheets API enabled)"
  }
}
