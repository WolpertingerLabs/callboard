{
  "name": "Gmail (read-only)",
  "stability": "beta",
  "category": "productivity",
  "description": "Gmail, read-only (scope gmail.readonly): messages and threads with bodies, attachments, labels, drafts, history, and search. Cannot send, modify, or delete. Auth: drawlatch mints short-lived access tokens from GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET and GOOGLE_OAUTH_REFRESH_TOKEN (user OAuth; the agent never sees them) and refuses any token broader than this scope. See CONNECTIONS.md \"Google (scoped)\".",
  "docsUrl": "https://developers.google.com/workspace/gmail/api/reference/rest",
  "secrets": {
    "GOOGLE_OAUTH_CLIENT_ID": "${GOOGLE_OAUTH_CLIENT_ID}",
    "GOOGLE_OAUTH_CLIENT_SECRET": "${GOOGLE_OAUTH_CLIENT_SECRET}",
    "GOOGLE_OAUTH_REFRESH_TOKEN": "${GOOGLE_OAUTH_REFRESH_TOKEN}"
  },
  "oauth2": {
    "tokenUrl": "https://oauth2.googleapis.com/token",
    "grant": "refresh_token",
    "clientAuth": "body",
    "secretRefs": {
      "clientId": "GOOGLE_OAUTH_CLIENT_ID",
      "clientSecret": "GOOGLE_OAUTH_CLIENT_SECRET",
      "refreshToken": "GOOGLE_OAUTH_REFRESH_TOKEN"
    },
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  },
  "allowedEndpoints": [
    "https://gmail.googleapis.com/gmail/v1/users/me/profile",
    "https://gmail.googleapis.com/gmail/v1/users/me/profile?**",
    "https://gmail.googleapis.com/gmail/v1/users/me/labels",
    "https://gmail.googleapis.com/gmail/v1/users/me/labels?**",
    "https://gmail.googleapis.com/gmail/v1/users/me/labels/*",
    "https://gmail.googleapis.com/gmail/v1/users/me/labels/*?**",
    "https://gmail.googleapis.com/gmail/v1/users/me/messages",
    "https://gmail.googleapis.com/gmail/v1/users/me/messages?**",
    "https://gmail.googleapis.com/gmail/v1/users/me/messages/*",
    "https://gmail.googleapis.com/gmail/v1/users/me/messages/*?**",
    "https://gmail.googleapis.com/gmail/v1/users/me/threads",
    "https://gmail.googleapis.com/gmail/v1/users/me/threads?**",
    "https://gmail.googleapis.com/gmail/v1/users/me/threads/*",
    "https://gmail.googleapis.com/gmail/v1/users/me/threads/*?**",
    "https://gmail.googleapis.com/gmail/v1/users/me/history",
    "https://gmail.googleapis.com/gmail/v1/users/me/history?**",
    "https://gmail.googleapis.com/gmail/v1/users/me/messages/*/attachments/*",
    "https://gmail.googleapis.com/gmail/v1/users/me/messages/*/attachments/*?**",
    "https://gmail.googleapis.com/gmail/v1/users/me/drafts",
    "https://gmail.googleapis.com/gmail/v1/users/me/drafts?**",
    "https://gmail.googleapis.com/gmail/v1/users/me/drafts/*",
    "https://gmail.googleapis.com/gmail/v1/users/me/drafts/*?**"
  ],
  "testConnection": {
    "url": "https://gmail.googleapis.com/gmail/v1/users/me/profile",
    "description": "Fetches the mailbox profile (email address, message count)"
  }
}
