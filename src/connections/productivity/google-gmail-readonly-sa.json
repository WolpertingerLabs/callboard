{
  "name": "Gmail (read-only, service account)",
  "stability": "beta",
  "category": "productivity",
  "description": "Gmail, read-only (scope gmail.readonly): messages and threads with bodies, attachments, labels, drafts, history, and search. Cannot send, modify, or delete. Auth: drawlatch signs a JWT with GOOGLE_SERVICE_ACCOUNT_KEY (base64 of the service-account JSON key file) and mints short-lived access tokens for exactly this scope; the agent never sees the key. Needs a subject (the mailbox to read) in the caller's oauth2Overrides; domain-wide delegation required. See CONNECTIONS.md \"Google (scoped)\".",
  "docsUrl": "https://developers.google.com/workspace/gmail/api/reference/rest",
  "secrets": {
    "GOOGLE_SERVICE_ACCOUNT_KEY": "${GOOGLE_SERVICE_ACCOUNT_KEY}"
  },
  "oauth2": {
    "tokenUrl": "https://oauth2.googleapis.com/token",
    "grant": "jwt_bearer",
    "secretRefs": {
      "serviceAccountKey": "GOOGLE_SERVICE_ACCOUNT_KEY"
    },
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly"
    ],
    "subjectRequired": true
  },
  "allowedEndpoints": [
    "https://gmail.googleapis.com/gmail/v1/users/me/profile",
    "https://gmail.googleapis.com/gmail/v1/users/me/labels",
    "https://gmail.googleapis.com/gmail/v1/users/me/labels?**",
    "https://gmail.googleapis.com/gmail/v1/users/me/labels/*",
    "https://gmail.googleapis.com/gmail/v1/users/me/labels/*?**",
    "https://gmail.googleapis.com/gmail/v1/users/me/messages",
    "https://gmail.googleapis.com/gmail/v1/users/me/messages?**",
    "https://gmail.googleapis.com/gmail/v1/users/me/messages/*",
    "https://gmail.googleapis.com/gmail/v1/users/me/messages/*?**",
    "https://gmail.googleapis.com/gmail/v1/users/me/threads",
    "https://gmail.googleapis.com/gmail/v1/users/me/threads?**",
    "https://gmail.googleapis.com/gmail/v1/users/me/threads/*",
    "https://gmail.googleapis.com/gmail/v1/users/me/threads/*?**",
    "https://gmail.googleapis.com/gmail/v1/users/me/history",
    "https://gmail.googleapis.com/gmail/v1/users/me/history?**",
    "https://gmail.googleapis.com/gmail/v1/users/me/messages/*/attachments/*",
    "https://gmail.googleapis.com/gmail/v1/users/me/messages/*/attachments/*?**",
    "https://gmail.googleapis.com/gmail/v1/users/me/drafts",
    "https://gmail.googleapis.com/gmail/v1/users/me/drafts?**",
    "https://gmail.googleapis.com/gmail/v1/users/me/drafts/*",
    "https://gmail.googleapis.com/gmail/v1/users/me/drafts/*?**"
  ],
  "testConnection": {
    "url": "https://gmail.googleapis.com/gmail/v1/users/me/profile",
    "description": "Fetches the mailbox profile (email address, message count)"
  }
}
